{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5F7FB"
    },
    "web": {
      "bundler": "metro",
      "name": "MiniLedger"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniLedger uses your photo library so you can attach receipt images to a loan.",
          "cameraPermission": "MiniLedger can use the camera if you choose to capture a receipt."
        }
      ]
    ],
    "android": {
      "package": "com.miniledger.app"
    },
    "ios": {
      "bundleIdentifier": "com.miniledger.app"
    }
  }
}
